### TypeScript token structure

For a TypeScript codebase, keep token names typed and avoid scattering raw HEX values throughout components.

```

export type ThemeId =
  | "graphite"
  | "precision-light"
  | "midnight-teal"
  | "engineering-blue";

export interface SemanticColorTokens {
  surface: {
    app: string;
    panel: string;
    raised: string;
    hover: string;
    input: string;
  };
  content: {
    primary: string;
    secondary: string;
    muted: string;
    disabled: string;
  };
  border: {
    subtle: string;
    default: string;
    strong: string;
  };
  action: {
    primary: string;
    primaryHover: string;
    primaryPressed: string;
    primaryForeground: string;
  };
  state: {
    focus: string;
    selection: string;
    success: string;
    warning: string;
    error: string;
    info: string;
  };
  canvas: {
    pasteboard: string;
    page: string;
    gridMinor: string;
