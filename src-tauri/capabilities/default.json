{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main and detached workspace windows",
  "windows": ["main", "workspace-*"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "dialog:default",
    "fs:allow-write-file",
    "fs:allow-read-file"
  ]
}
