{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "E-Studio",
  "version": "1.0.0",
  "identifier": "com.estudio.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "icon": ["../public/pwa-512x512.png"]
  },
  "app": {
    "windows": [
      {
        "title": "E-Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 1280,
        "minHeight": 800,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: asset:; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' asset: data:; script-src 'self'"
    }
  },
  "plugins": {
    "dialog": {},
    "fs": {}
  }
}
